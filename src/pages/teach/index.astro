---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MadeByKaj from '../../components/MadeByKaj.astro';

const basePath = import.meta.env.BASE_URL;

const lessons = [
	{
		title: 'The Hertzsprung-Russell diagram',
		href: `${basePath}learn/topic/hr-diagram/`,
		summary:
			'Use a real stellar sample to connect colour, temperature, luminosity, stellar evolution, and observational bias.',
		bestFor: 'upper secondary, undergraduate, curious adults',
		time: '20-40 minutes',
		astronomy: 'stellar evolution',
		data: 'absolute vs apparent quantities, sample limits',
	},
	{
		title: 'Constellations and 3D space',
		href: `${basePath}explore/constellations-and-3d-space/`,
		summary:
			'Start from Orion, then move through the local star field to show how perspective turns 3D space into sky patterns.',
		bestFor: 'lower secondary upward, outreach',
		time: '10-25 minutes',
		astronomy: 'constellations and distance',
		data: 'projection, viewpoint, parallax',
	},
	{
		title: 'Parallax',
		href: `${basePath}explore/parallax/`,
		summary:
			'Move the observer and watch nearby stars slide more than distant ones, making distance measurement visible.',
		bestFor: 'secondary, first-year undergraduate',
		time: '10-20 minutes',
		astronomy: 'measuring stellar distance',
		data: 'triangulation and uncertainty',
	},
	{
		title: 'Star clusters',
		href: `${basePath}learn/topic/star-clusters/`,
		summary:
			'Compare real stellar families and ask why clusters are useful natural laboratories for understanding stars.',
		bestFor: 'upper secondary, undergraduate',
		time: '20-35 minutes',
		astronomy: 'stellar age and formation',
		data: 'controlled comparisons in messy data',
	},
	{
		title: 'The radio bubble',
		href: `${basePath}learn/topic/radio-bubble/`,
		summary:
			'Use the scale of radio signals leaving Earth to discuss distance, detectability, and the size of the local neighbourhood.',
		bestFor: 'secondary, outreach, discussion sessions',
		time: '15-30 minutes',
		astronomy: 'scale and light-travel time',
		data: 'model assumptions and detectability',
	},
];

const questions = [
	'Do the brightest stars have to be the closest?',
	'Why do Orion and the Pleiades look elongated in some 3D views?',
	'What changes when students move from apparent brightness to true luminosity?',
	'Which features in a star map are physical, and which come from measurement limits?',
];
---

<Layout
	title="Teach | Found in Space"
	description="Adapt experiences and prompts for teaching with scientific data and models. Browse current astronomy activities and questions about worlds, eclipses and representation."
>
	<SiteHeader section="Teach with data and models" />

	<main class="page">
		<header class="hero teach-hero">
			<p class="eyebrow">Teach with data and models</p>
			<h1>Make room for curiosity, evidence, and making.</h1>
			<p class="lede">
				Help learners ask what a measurement or model can tell them, try a different
				representation, or make something of their own. The current guided activities focus on
				astronomy; the wider projects offer more starting points for scale, prediction, and creative work.
			</p>
			<div class="hero__actions">
				<a class="button button--primary" href="#ready-to-use-activities">Start with an activity</a>
				<a class="button button--ghost" href="#inquiry">Run an inquiry activity</a>
				<a class="button button--ghost" href={`${basePath}build/`}>Create or adapt</a>
			</div>
		</header>

		<section class="teacher-answers" aria-label="Teacher questions answered">
			<article class="panel">
				<p class="panel__eyebrow">Use it quickly</p>
				<h2>Can I use this in a lesson?</h2>
				<p>
					Preview a guided viewer or activity page, then adapt the prompts below for discussion,
					worksheet questions, or small-group investigation in your setting.
				</p>
			</article>
			<article class="panel">
				<p class="panel__eyebrow">Choose a level</p>
				<h2>What age or stage is it for?</h2>
				<p>
					The suggested levels start at secondary school. Levels and timings are planning
					estimates for you to adapt, rather than results from classroom evaluation.
				</p>
			</article>
			<article class="panel">
				<p class="panel__eyebrow">Extend it</p>
				<h2>Do students need coding?</h2>
				<p>
					The visual activities do not require coding. Making can mean choosing examples or
					composing an investigation; data and coding guides offer optional extensions.
				</p>
			</article>
		</section>

		<section class="lesson-section" id="ready-to-use-activities" aria-label="Current astronomy activities">
			<div class="section-heading">
				<p class="eyebrow">Current astronomy activities</p>
				<h2>Start with a guided visualisation.</h2>
				<p>
					Each activity pairs an astronomy idea with a data idea. Use the pairing to discuss
					both the phenomenon and how its representation was made. Learners can explore freely,
					compare cases, or follow a question; there is no single required lesson sequence.
				</p>
			</div>

			<div class="lesson-list">
				{lessons.map((lesson) => (
					<a class="panel lesson-card" href={lesson.href}>
						<div class="lesson-card__body">
							<h3>{lesson.title}</h3>
							<p>{lesson.summary}</p>
						</div>
						<dl class="lesson-card__meta">
							<div>
								<dt>Suggested level</dt>
								<dd>{lesson.bestFor}</dd>
							</div>
							<div>
								<dt>Estimated time</dt>
								<dd>{lesson.time}</dd>
							</div>
							<div>
								<dt>Astronomy idea</dt>
								<dd>{lesson.astronomy}</dd>
							</div>
							<div>
								<dt>Data idea</dt>
								<dd>{lesson.data}</dd>
							</div>
						</dl>
						<span class="lesson-card__cta">Open activity</span>
					</a>
				))}
			</div>
		</section>

		<section class="inquiry" id="inquiry" aria-label="Inquiry activities">
			<div class="inquiry__intro">
				<p class="eyebrow">Investigations</p>
				<h2>Ask questions students can investigate, not just answer.</h2>
				<p>
					Real data carries uncertainty, selection effects, coordinate choices, and measurement
					limits. That is exactly why it is useful in a classroom: students can test whether a
					pattern comes from the stars, the sample, or the way the data is shown.
				</p>
			</div>
			<div class="panel panel--accent inquiry__panel">
				<h3>Good starting questions</h3>
				<ul>
					{questions.map((question) => <li>{question}</li>)}
				</ul>
				<a class="button button--ghost" href={`${basePath}learn/next-steps/`}>
					Browse research questions
				</a>
			</div>
		</section>

		<section class="hub-section" aria-labelledby="beyond-stars-title">
			<h2 id="beyond-stars-title">Questions beyond the star field.</h2>
			<p>These are prompts to adapt, not complete teaching packs. Check each project’s setup and availability before planning a session.</p>
			<div class="section-grid section-grid--two">
				<article class="panel destination-card"><p class="panel__eyebrow">Prediction · Shadowline</p><h3>One eclipse, two places.</h3><p>Ask learners to predict how the eclipse differs at two locations, then compare the model’s local circumstances and discuss what produced the difference.</p><div class="destination-card__links"><a class="link--gold" href={`${basePath}projects/eclipses/`}>Find the eclipse explorer and model →</a></div></article>
				<article class="panel destination-card"><p class="panel__eyebrow">Scale · Pas de Géant</p><h3>A world at a different scale.</h3><p>Compare two scales or viewpoints. Ask which distances belong to the physical world and which belong to the display. Immersive exploration uses a WebXR-capable headset; the project guide also documents desktop controls.</p><div class="destination-card__links"><a class="link--gold" href={`${basePath}projects/worlds/`}>Read about worlds and access →</a></div></article>
			</div>
			<p>For further ideas, including the questions behind Aeolian Measure’s work in private development,
				<a class="link--gold" href={`${basePath}question/`}>browse the Question route</a>.</p>
		</section>

		<section class="adapt" aria-label="Create or adapt a visualisation">
			<div>
				<p class="eyebrow">Create or adapt</p>
				<h2>Move from using the visuals to building with the data.</h2>
			</div>
			<div class="adapt__body">
				<p>
					Students can begin with a small bright-star data guide, make a chart or simple 3D
					scene, then move toward the full open pipeline if they want to understand how Gaia
					and Hipparcos become a browser-ready star map.
				</p>
				<div class="adapt__actions">
					<a class="button button--primary" href={`${basePath}build/`}>Find materials to build with</a>
					<a class="button button--ghost" href={`${basePath}build/download-the-star-data/`}>
						Use the starter guide
					</a>
				</div>
			</div>
		</section>

		<MadeByKaj />
	</main>
</Layout>

<style>
	.teach-hero {
		max-width: 58rem;
		padding-top: 3.5rem;
	}

	h1,
	h2,
	h3 {
		font-weight: 600;
		letter-spacing: 0;
	}

	h1 {
		max-width: 15ch;
		margin: 0;
		font-size: 4.4rem;
		line-height: 1;
	}

	h2 {
		margin: 0 0 0.8rem;
		font-size: 1.8rem;
		line-height: 1.12;
		color: var(--fis-text);
	}

	h3 {
		margin: 0 0 0.65rem;
		font-size: 1.35rem;
		line-height: 1.18;
		color: var(--fis-text);
	}

	p {
		margin: 0;
		line-height: 1.7;
		color: var(--fis-text-soft);
	}

	.hero__actions,
	.adapt__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.button--ghost {
		background: var(--fis-panel);
	}

	.teacher-answers {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-bottom: 4rem;
	}

	.lesson-section {
		display: grid;
		grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
		gap: 3rem;
		padding-top: 4rem;
		border-top: 1px solid var(--fis-line);
	}

	.section-heading {
		position: sticky;
		top: 6.5rem;
		align-self: start;
	}

	.section-heading h2,
	.inquiry__intro h2,
	.adapt h2 {
		font-size: 2.3rem;
		line-height: 1.08;
	}

	.lesson-list {
		display: grid;
		gap: 1rem;
	}

	.lesson-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(14rem, 0.8fr);
		gap: 1.5rem;
		text-decoration: none;
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.lesson-card:hover {
		border-color: var(--fis-line-strong);
		transform: translateY(-3px);
	}

	.lesson-card__meta {
		display: grid;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
	}

	.lesson-card__meta div {
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--fis-line);
	}

	.lesson-card__meta div:last-child {
		padding-bottom: 0;
		border-bottom: 0;
	}

	.lesson-card__meta dt {
		margin-bottom: 0.2rem;
		color: var(--fis-gold);
		font-family: var(--fis-font-ui);
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
	}

	.lesson-card__meta dd {
		margin: 0;
		color: var(--fis-text-soft);
		line-height: 1.45;
	}

	.lesson-card__cta {
		grid-column: 1 / -1;
		color: var(--fis-gold);
		font-family: var(--fis-font-ui);
		font-size: 0.94rem;
	}

	.inquiry,
	.adapt {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 3rem;
		padding: 4rem 0;
		border-top: 1px solid var(--fis-line);
	}

	.inquiry {
		margin-top: 4rem;
	}

	.inquiry__panel {
		padding: 2rem;
	}

	.inquiry__panel ul {
		display: grid;
		gap: 0.75rem;
		margin: 1rem 0 1.5rem;
		padding-left: 1.2rem;
		color: var(--fis-text-soft);
		line-height: 1.65;
	}

	.adapt {
		margin-bottom: 4rem;
	}

	.adapt__body {
		max-width: 42rem;
	}

	@media (max-width: 960px) {
		h1 {
			font-size: 3.6rem;
		}

		.teacher-answers,
		.lesson-section,
		.lesson-card,
		.inquiry,
		.adapt {
			grid-template-columns: 1fr;
		}

		.section-heading {
			position: static;
		}
	}

	@media (max-width: 720px) {
		h1 {
			font-size: 2.9rem;
		}

		.hero__actions,
		.adapt__actions {
			align-items: stretch;
			flex-direction: column;
		}

		.hero__actions .button,
		.adapt__actions .button {
			width: 100%;
		}
	}
</style>
