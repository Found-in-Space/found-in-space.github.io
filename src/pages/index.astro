---
import MadeByKaj from '../components/MadeByKaj.astro';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
const basePath = import.meta.env.BASE_URL;
---

<Layout title="Found in Space — Explore. Question. Build." description="Think and create with scientific data and models. Explore stars, worlds and eclipses, follow the evidence, and find materials for making something of your own.">
	<SiteHeader />
	<main class="page">
		<header class="hero hub-hero home-hero">
			<p class="eyebrow">Tools for thinking and creating with data and models</p>
			<h1>Explore. Question. Build.</h1>
			<p class="lede">Scientific data and models are materials to make something with.
				Discover the depth of a star field, change the scale of a world, or follow an eclipse.
				Get curious about the evidence behind it. Make an investigation, a lesson, or an experience of your own.</p>
		</header>
		<section class="section-grid section-grid--three" aria-label="Choose your way in">
			<article class="panel destination-card">
				<p class="panel__eyebrow">Explore</p><h2>Follow your curiosity.</h2>
				<p>Move, play, and notice what changes. Find an experience that gives you a new way to see something.</p>
				<div class="destination-card__links"><a class="link--gold" href={`${basePath}explore/`}>Find an experience →</a></div>
			</article>
			<article class="panel destination-card">
				<p class="panel__eyebrow">Question</p><h2>Look into the evidence.</h2>
				<p>What can this view tell you? Investigate the measurements, assumptions, and choices that shape it.</p>
				<div class="destination-card__links"><a class="link--gold" href={`${basePath}question/`}>Find a question to investigate →</a></div>
			</article>
			<article class="panel destination-card">
				<p class="panel__eyebrow">Build</p><h2>Make something of your own.</h2>
				<p>Adapt an activity, compose a journey, or work with reusable data, models, and tools.</p>
				<div class="destination-card__links"><a class="link--gold" href={`${basePath}build/`}>Find materials and tools →</a></div>
			</article>
		</section>
		<section class="hub-section" aria-labelledby="projects-title">
			<p class="eyebrow">Many ways to make science tangible</p>
			<h2 id="projects-title">From star fields to musical experiments.</h2>
			<p>Each project offers a different way to think and create with scientific material.
				Some are ready to explore in a browser; others need setup or are still taking shape.</p>
			<div class="section-grid section-grid--two">{projects.map((project) => <ProjectCard project={project} />)}</div>
		</section>
		<section class="hub-note prose" aria-labelledby="purpose-title">
			<h2 id="purpose-title">An experience can open onto its materials.</h2>
			<p>Enjoying a view or playing with an idea is a worthwhile place to start—and stay.
				When you want to go further, follow the sources, explore a model’s assumptions,
				or use the same materials to create something new. Exploring, questioning, and building are all ways in.</p>
			<p>Our educational ambition is <strong>data and model literacy</strong>: recognising what we can ask,
				what the evidence supports, and what we would need to find out next.</p>
			<div class="action-links"><a class="button button--ghost" href={`${basePath}teach/`}>Teach with these materials</a><a class="link--gold" href={`${basePath}about/`}>About Found in Space →</a></div>
		</section>
		<MadeByKaj />
	</main>
</Layout>
<style>
	.home-hero { max-width: 63rem; }
	.home-hero h1 { font-size: clamp(3rem, 7vw, 5.7rem); }
	.home-hero .lede { max-width: 49rem; }
</style>
