---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MadeByKaj from '../../components/MadeByKaj.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
const basePath = import.meta.env.BASE_URL;
---

<Layout title="Explore | Found in Space" description="Find experiences with star fields, worlds and eclipse predictions, and discover musical experiments with measurements. See what is available and how to begin.">
	<SiteHeader section="Explore" />
	<main class="page">
		<header class="hero hub-hero">
			<p class="eyebrow">Explore</p><h1>Let curiosity choose the destination.</h1>
			<p class="lede">Move through a star field, follow a shadow, or discover a world at a different scale.
				You can enjoy an experience, play with its controls, or follow a question that catches your attention.</p>
			<div class="action-links"><a class="button button--primary" href={`${basePath}explore/constellations-and-3d-space/`}>Enter a star field</a><a class="button button--ghost" href="https://foundin.space/shadowline/browse/">Explore an eclipse</a></div>
		</header>
		<section class="hub-section" aria-labelledby="experiences-title">
			<h2 id="experiences-title">Find your way in.</h2>
			<p>Browser experiences open directly. Project pages explain access, the materials behind the experience, and where to go next.</p>
			<div class="section-grid section-grid--two">{projects.map((project) => <ProjectCard project={project} launch />)}</div>
		</section>
		<section class="hub-section" aria-labelledby="more-title">
			<h2 id="more-title">A different way to explore the stars.</h2>
			<div class="section-grid section-grid--two">
				<article class="panel destination-card">
					<p class="panel__eyebrow">Move the observer</p><h3>Feel parallax.</h3>
					<p>Shift your viewpoint and compare how nearby and distant stars move across the sky.</p>
					<div class="destination-card__links"><a class="link--gold" href={`${basePath}explore/parallax/`}>Try parallax →</a></div>
				</article>
				<article class="panel destination-card">
					<p class="panel__eyebrow">Play with a representation</p><h3>Pilot a path through stars.</h3>
					<p>Star Pilot uses a slice of Gaia-derived stars in a small browser game, with its own choices about visibility and brightness.</p>
					<div class="destination-card__links"><a class="link--gold" href="https://foundin.space/star-pilot/">Play Star Pilot →</a><a class="link--gold" href="https://github.com/Found-in-Space/star-pilot">See how it is made →</a></div>
				</article>
			</div>
		</section>
		<section class="hub-note prose">
			<h2>Curious about what you are seeing?</h2>
			<p>A measurement, a prediction, and an artistic mapping tell us different things.
				The <a href={`${basePath}question/`}>Question route</a> offers ways to investigate those differences.
				The <a href={`${basePath}build/`}>Build route</a> opens up materials for making your own representation.</p>
		</section>
		<MadeByKaj />
	</main>
</Layout>
