---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import MadeByKaj from '../../components/MadeByKaj.astro';

const basePath = import.meta.env.BASE_URL;

const learningPaths = [
	{
		title: 'Constellations',
		href: `${basePath}explore/constellations-and-3d-space/`,
		astronomy: 'sky patterns vs physical space',
		data: 'projection and perspective',
	},
	{
		title: 'Parallax',
		href: `${basePath}explore/parallax/`,
		astronomy: 'measuring distance',
		data: 'viewpoint and triangulation',
	},
	{
		title: 'HR diagram',
		href: `${basePath}learn/topic/hr-diagram/`,
		astronomy: 'stellar evolution',
		data: 'sampling bias and absolute vs apparent quantities',
	},
	{
		title: 'Star clusters',
		href: `${basePath}learn/topic/star-clusters/`,
		astronomy: 'stellar age and formation',
		data: 'natural laboratories and controlled comparisons',
	},
	{
		title: 'Radio bubble',
		href: `${basePath}learn/topic/radio-bubble/`,
		astronomy: 'scale and light-speed limits',
		data: 'model assumptions and detectability',
	},
	{
		title: 'Astrophage',
		href: `${basePath}learn/topic/astrophage/`,
		astronomy: 'local stellar geography',
		data: 'nearest-neighbour paths through real data',
	},
];
---

<Layout
	title="Learn & Build | Found in Space"
	description="Learn astronomy and data concepts, download starter star data, inspect the open pipeline, or build your own data-driven experience."
>
	<SiteHeader section="Learn & build" />

	<main class="page">
		<header class="hero learn-build-hero">
			<p class="eyebrow">Learn &amp; build with the data</p>
			<h1>Move from seeing the stars to working with the data behind them.</h1>
			<p class="lede">
				Start with a guided lesson, use a small prepared dataset, or inspect the open pipeline
				that turns Gaia and Hipparcos catalogues into browser-ready 3D star maps.
			</p>
			<div class="hero__actions">
				<a class="button button--primary" href={`${basePath}learn/topic/hr-diagram/`}>Start learning</a>
				<a class="button button--ghost" href={`${basePath}build/download-the-star-data/`}>Get starter data</a>
				<a class="button button--ghost" href={`${basePath}build/`}>Inspect the pipeline</a>
			</div>
		</header>

		<section class="doors" aria-label="Ways to learn and build">
			<article class="panel panel--accent">
				<p class="panel__eyebrow">Use the data</p>
				<h2>Build something visible first.</h2>
				<p>
					Download a small bright-star sample, understand the columns, and make a chart,
					notebook, simple 3D scene, or classroom visualisation before tackling the full dataset.
				</p>
				<a class="link--gold" href={`${basePath}build/download-the-star-data/`}>Start with the data guide</a>
			</article>
			<article class="panel">
				<p class="panel__eyebrow">Learn concepts</p>
				<h2>Pair astronomy with data thinking.</h2>
				<p>
					Each topic is designed to teach both what the universe is doing and how measurements,
					selection effects, and assumptions shape what you see.
				</p>
				<a class="link--gold" href={`${basePath}learn/`}>Browse the lessons</a>
			</article>
			<article class="panel">
				<p class="panel__eyebrow">Run the machinery</p>
				<h2>Open the pipeline when you are ready.</h2>
				<p>
					Follow the route from raw catalogues to cleaned Parquet, spatial indexing, streaming
					cells, and the browser viewer.
				</p>
				<a class="link--gold" href={`${basePath}build/`}>Read the technical overview</a>
			</article>
		</section>

		<section class="concept-map" aria-label="Astronomy and data ideas">
			<div class="concept-map__intro">
				<p class="eyebrow">What each topic teaches</p>
				<h2>Every lesson has an astronomy idea and a data idea.</h2>
				<p>
					This is the bridge between wonder and understanding: a star map becomes more powerful
					when students also learn how the map was made, where it is reliable, and where it needs
					to be questioned.
				</p>
			</div>
			<div class="concept-list">
				{learningPaths.map((item) => (
					<a class="concept-row" href={item.href}>
						<h3>{item.title}</h3>
						<p><strong>Astronomy:</strong> {item.astronomy}</p>
						<p><strong>Data:</strong> {item.data}</p>
					</a>
				))}
			</div>
		</section>

		<section class="builder-layers" aria-label="Build layers">
			<div class="section-heading">
				<p class="eyebrow">Builder path</p>
				<h2>Three levels of depth.</h2>
			</div>
			<div class="builder-layers__cards">
				<article class="panel">
					<p class="panel__eyebrow">Beginner</p>
					<h3>Use a prepared dataset</h3>
					<p>
						Start small: bright nearby stars, readable columns, and enough structure to make a
						chart, classroom prompt, or simple visual experience.
					</p>
				</article>
				<article class="panel">
					<p class="panel__eyebrow">Pipeline</p>
					<h3>Rebuild the data</h3>
					<p>
						Install the open pipeline, download source catalogues, merge Gaia with Hipparcos,
						and produce the Parquet outputs used by the site.
					</p>
				</article>
				<article class="panel">
					<p class="panel__eyebrow">Machinery</p>
					<h3>Understand the viewer</h3>
					<p>
						Learn how a spatial index lets a browser stream what it needs instead of downloading
						a billion-row star table.
					</p>
				</article>
			</div>
		</section>

		<section class="next-step panel panel--wide">
			<div>
				<p class="panel__eyebrow">Open questions</p>
				<h2>Ready for an investigation?</h2>
				<p>
					Try a research brief that asks whether a visible structure is physical, a consequence of
					measurement geometry, or an artefact of the way the data is rendered.
				</p>
			</div>
			<a class="button button--primary" href={`${basePath}learn/next-steps/`}>
				Browse research questions
			</a>
		</section>

		<MadeByKaj />
	</main>
</Layout>

<style>
	.learn-build-hero {
		max-width: 58rem;
		padding-top: 3.5rem;
	}

	h1,
	h2,
	h3 {
		font-weight: 600;
		letter-spacing: 0;
	}

	h1 {
		max-width: 15ch;
		margin: 0;
		font-size: 4.4rem;
		line-height: 1;
	}

	h2 {
		margin: 0 0 0.8rem;
		font-size: 1.8rem;
		line-height: 1.12;
		color: var(--fis-text);
	}

	h3 {
		margin: 0 0 0.55rem;
		font-size: 1.28rem;
		line-height: 1.18;
		color: var(--fis-text);
	}

	p {
		margin: 0;
		line-height: 1.7;
		color: var(--fis-text-soft);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.button--ghost {
		background: var(--fis-panel);
	}

	.doors,
	.builder-layers__cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.doors {
		margin-bottom: 4rem;
	}

	.doors .panel {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.doors a {
		margin-top: auto;
		padding-top: 0.8rem;
	}

	.concept-map,
	.builder-layers {
		display: grid;
		grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
		gap: 3rem;
		padding: 4rem 0;
		border-top: 1px solid var(--fis-line);
	}

	.concept-map__intro,
	.section-heading {
		position: sticky;
		top: 6.5rem;
		align-self: start;
	}

	.concept-map__intro h2,
	.section-heading h2 {
		font-size: 2.3rem;
		line-height: 1.08;
	}

	.concept-list {
		display: grid;
		gap: 0.75rem;
	}

	.concept-row {
		display: grid;
		grid-template-columns: minmax(9rem, 0.55fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: 1rem;
		align-items: start;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--fis-line);
		text-decoration: none;
		transition: border-color 160ms ease;
	}

	.concept-row:hover {
		border-bottom-color: var(--fis-line-strong);
	}

	.concept-row p {
		font-size: 0.96rem;
		color: var(--fis-text-muted);
	}

	.concept-row strong {
		color: var(--fis-text-soft);
		font-weight: 600;
	}

	.builder-layers {
		margin-bottom: 1rem;
	}

	.next-step {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 4rem;
	}

	.next-step div {
		max-width: 42rem;
	}

	@media (max-width: 960px) {
		h1 {
			font-size: 3.6rem;
		}

		.doors,
		.builder-layers__cards,
		.concept-map,
		.builder-layers,
		.concept-row {
			grid-template-columns: 1fr;
		}

		.concept-map__intro,
		.section-heading {
			position: static;
		}

		.next-step {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (max-width: 720px) {
		h1 {
			font-size: 2.9rem;
		}

		.hero__actions {
			align-items: stretch;
			flex-direction: column;
		}

		.hero__actions .button,
		.next-step .button {
			width: 100%;
		}
	}
</style>
