---
import MadeByKaj from '../components/MadeByKaj.astro';
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';

const basePath = import.meta.env.BASE_URL;
const explorePath = `${basePath}explore/`;
const teachPath = `${basePath}teach/`;
const learnBuildPath = `${basePath}learn-build/`;
const constellationFlyThroughPath = `${basePath}explore/constellations-and-3d-space/`;
const hrDiagramPath = `${basePath}learn/topic/hr-diagram/`;
const starterDataPath = `${basePath}build/download-the-star-data/`;
const aboutPath = `${basePath}about/`;
---

<Layout
	title="Found in Space"
	description="Found in Space helps people learn through real space data with interactive 3D experiences, teaching material, and open datasets and code."
>
	<SiteHeader section="Learning through data" />

	<main class="page">
		<section class="hero home-hero">
			<p class="eyebrow">Learning through data</p>
			<h1>Explore the nearby stars. Learn how data makes them visible.</h1>
			<p class="lede">
				Found in Space turns open astronomical catalogues into interactive 3D experiences,
				lessons, and code. Fly through real stars, teach with guided investigations, or build
				your own data-driven visualisations from the same data.
			</p>
			<div class="hero__actions" aria-label="Primary routes">
				<a class="button button--primary" href={explorePath}>Explore the stars</a>
				<a class="button button--ghost" href={teachPath}>Teach with Found in Space</a>
				<a class="button button--ghost" href={learnBuildPath}>Learn &amp; build with the data</a>
			</div>
		</section>

		<section class="route-grid" aria-label="Choose a route">
			<a class="panel panel--accent route-card" href={explorePath}>
				<p class="panel__eyebrow">Explore the stars</p>
				<h2>Start with wonder.</h2>
				<p>
					For anyone who wants to see the sky differently. Begin with familiar constellations,
					then move through real 3D star positions and watch the flat night sky open into depth.
				</p>
				<p class="route-card__meta">Best for: first-time visitors, visual exploration, public engagement</p>
				<span class="route-card__cta">Start with the Orion fly-through</span>
			</a>

			<a class="panel route-card" href={teachPath}>
				<p class="panel__eyebrow">Teach with real data</p>
				<h2>Turn visuals into inquiry.</h2>
				<p>
					For teachers, lecturers, and workshop leaders. Use guided visualisations, classroom
					prompts, and open-ended investigations built from real astronomical measurements.
				</p>
				<p class="route-card__meta">Best for: lessons, workshops, outreach, student projects</p>
				<span class="route-card__cta">Open the teacher hub</span>
			</a>

			<a class="panel route-card" href={learnBuildPath}>
				<p class="panel__eyebrow">Learn &amp; build</p>
				<h2>Work with the data.</h2>
				<p>
					For students, pupils, curious coders, and independent learners. Learn astronomy and
					data concepts, inspect the pipeline, or build your own visual experience.
				</p>
				<p class="route-card__meta">Best for: self-study, starter data, notebooks, code, projects</p>
				<span class="route-card__cta">Find a starting point</span>
			</a>
		</section>

		<section class="definition" aria-label="What is Found in Space?">
			<div class="definition__copy">
				<p class="eyebrow">What is Found in Space?</p>
				<h2>Part planetarium, part classroom, part open data lab.</h2>
			</div>
			<div class="definition__body">
				<p>
					It uses real measurements from Gaia, Hipparcos, and other catalogues to help people see
					how raw data becomes knowledge, and how knowledge can become something you can explore.
				</p>
				<p>
					Real data is powerful because it can surprise you, and because it teaches you to ask what
					the data can and cannot show.
				</p>
			</div>
		</section>

		<section class="proof" aria-label="What the project includes">
			<ul class="proof__list">
				<li>Real Gaia and Hipparcos star data</li>
				<li>Interactive 3D browser visualisations</li>
				<li>Guided lessons and investigations</li>
				<li>Open pipeline and source code</li>
				<li>Starter datasets for experiments and projects</li>
			</ul>
		</section>

		<section class="start-points" aria-label="Suggested first steps">
			<article class="panel">
				<p class="panel__eyebrow">First look</p>
				<h2>Constellations and 3D space</h2>
				<p>
					Start with Orion and see how a familiar sky pattern changes when each star is placed at
					its measured distance.
				</p>
				<a class="link--gold" href={constellationFlyThroughPath}>Open the fly-through</a>
			</article>
			<article class="panel">
				<p class="panel__eyebrow">Flagship lesson</p>
				<h2>The HR diagram</h2>
				<p>
					Plot temperature against luminosity, then ask what the structure tells you and what the
					sample might be hiding.
				</p>
				<a class="link--gold" href={hrDiagramPath}>Open the lesson</a>
			</article>
			<article class="panel">
				<p class="panel__eyebrow">Starter data</p>
				<h2>Build something visible</h2>
				<p>
					Begin with a small prepared star dataset before deciding whether to run the full Gaia
					pipeline yourself.
				</p>
				<a class="link--gold" href={starterDataPath}>Get the data</a>
			</article>
		</section>

		<section class="about-teaser" aria-label="About the project">
			<p>
				Found in Space is not just a star viewer. It is a way to learn how data becomes
				understanding.
			</p>
			<a class="button button--ghost" href={aboutPath}>About the project</a>
		</section>

		<MadeByKaj />
	</main>
</Layout>

<style>
	.page {
		position: relative;
		min-height: 100vh;
	}

	.home-hero {
		max-width: 58rem;
		padding-top: 4.5rem;
		padding-bottom: 3.5rem;
	}

	h1,
	h2,
	h3 {
		font-weight: 600;
		letter-spacing: 0;
	}

	h1 {
		max-width: 13ch;
		margin: 0;
		font-size: 4.8rem;
		line-height: 1;
	}

	h2 {
		margin: 0 0 0.8rem;
		font-size: 1.7rem;
		line-height: 1.12;
		color: var(--fis-text);
	}

	p {
		margin: 0;
		line-height: 1.7;
		color: var(--fis-text-soft);
	}

	p + p {
		margin-top: 1rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		margin-top: 2rem;
	}

	.button--ghost {
		background: var(--fis-panel);
	}

	.route-grid,
	.start-points {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.route-grid {
		margin: 0 0 4rem;
	}

	.route-card {
		display: flex;
		flex-direction: column;
		min-height: 24rem;
		text-decoration: none;
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.route-card:hover {
		border-color: var(--fis-line-strong);
		transform: translateY(-3px);
	}

	.route-card__meta {
		margin-top: 1.2rem;
		font-family: var(--fis-font-ui);
		font-size: 0.9rem;
		color: var(--fis-text-muted);
	}

	.route-card__cta {
		display: block;
		margin-top: auto;
		padding-top: 1.4rem;
		color: var(--fis-gold);
		font-family: var(--fis-font-ui);
		font-size: 0.94rem;
	}

	.definition {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: 3rem;
		padding: 4rem 0;
		border-top: 1px solid var(--fis-line);
		border-bottom: 1px solid var(--fis-line);
	}

	.definition h2 {
		max-width: 15ch;
		font-size: 2.4rem;
		line-height: 1.06;
	}

	.definition__body {
		max-width: 42rem;
		font-size: 1.12rem;
	}

	.proof {
		padding: 2rem 0 3.4rem;
	}

	.proof__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.proof__list li {
		padding: 0.45rem 0.75rem;
		border: 1px solid var(--fis-blue-subtle);
		border-radius: 999px;
		background: var(--fis-panel);
		color: var(--fis-text-soft);
		font-family: var(--fis-font-ui);
		font-size: 0.9rem;
	}

	.start-points {
		margin-bottom: 3rem;
	}

	.start-points .panel {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
	}

	.start-points a {
		margin-top: auto;
		padding-top: 0.6rem;
	}

	.about-teaser {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 4rem;
		padding: 1.5rem 0 0;
		border-top: 1px solid var(--fis-line);
	}

	.about-teaser p {
		max-width: 42rem;
		font-size: 1.2rem;
		color: var(--fis-text);
	}

	@media (max-width: 960px) {
		h1 {
			font-size: 3.8rem;
		}

		.route-grid,
		.start-points,
		.definition {
			grid-template-columns: 1fr;
		}

		.route-card {
			min-height: auto;
		}

		.definition {
			gap: 1.5rem;
		}
	}

	@media (max-width: 720px) {
		.home-hero {
			padding-top: 2.5rem;
		}

		h1 {
			font-size: 3rem;
		}

		.hero__actions,
		.about-teaser {
			align-items: stretch;
			flex-direction: column;
		}

		.hero__actions .button,
		.about-teaser .button {
			width: 100%;
		}
	}
</style>
