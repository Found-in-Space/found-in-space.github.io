---
import '../styles/theme.css';
import '../styles/components.css';
import '../styles/prose.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Found in Space',
	description = 'Explore open astronomical measurements through interactive 3D views, guided inquiry, and reusable data and code.',
} = Astro.props;
const basePath = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={`${basePath}robbie.ico`} />
		<link rel="icon" type="image/png" href={`${basePath}robbie-32.png`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<!-- 100% privacy-first analytics -->
		<script
			is:inline
			data-collect-dnt="true"
			async
			src="https://scripts.simpleanalyticscdn.com/latest.js"
		></script>
		<noscript
			><img
				src="https://queue.simpleanalyticscdn.com/noscript.gif?collect-dnt=true"
				alt=""
				referrerpolicy="no-referrer-when-downgrade"
			/></noscript
		>
	</body>
</html>
